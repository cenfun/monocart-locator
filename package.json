{
    "name": "monocart-locator",
    "version": "2.0.0",
    "description": "A lightweight source code position locator for converting between offset and line/column, with built-in line and comment parsing",
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "types": "./lib/index.d.ts",
    "scripts": {
        "test": "mcr test ./test/test.js -r v8,console-summary -o ./.temp/coverage --all ./lib --outputFilter \"lib/**/*.js\""
    },
    "files": [
        "lib"
    ],
    "keywords": [
        "locator",
        "source",
        "position",
        "offset",
        "line",
        "column",
        "comment",
        "parser"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cenfun/monocart-locator.git"
    },
    "devDependencies": {
        "console-grid": "^2.2.4",
        "eight-colors": "^1.3.3",
        "eslint": "^10.12.0",
        "eslint-config-plus": "^2.1.0",
        "monocart-coverage-reports": "^3.2.1"
    }
}
